VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Spring Boot backend that powers the sorting engine and quiz scoring.
# Leave it unset to use http://localhost:8080 (the default). The frontend
# silently falls back to the in-browser TypeScript engine when unreachable.
VITE_JAVA_BACKEND_URL=http://localhost:8080